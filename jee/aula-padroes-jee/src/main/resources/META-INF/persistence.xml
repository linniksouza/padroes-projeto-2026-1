<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.0">

    <persistence-unit name="aulaPU">
        <jta-data-source>java:/DSSQLITE</jta-data-source>

        <properties>
            <property
                name="hibernate.hbm2ddl.auto"
                value="update"/>

            <property
                name="hibernate.show_sql"
                value="true"/>
        </properties>
    </persistence-unit>
</persistence>